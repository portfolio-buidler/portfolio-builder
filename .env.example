###############################################
# Portfolio Builder – Environment Configuration
# Copy this file to .env and adjust values.
# Windows PowerShell: cp .env.example .env
###############################################

# ---------- Postgres ------------
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio_password
POSTGRES_DB=portfolio_db
POSTGRES_PORT=5432

# ---------- Backend -------------
# External host port to expose FastAPI (host:container -> BACKEND_PORT:8000)
BACKEND_PORT=9000

# Async SQLAlchemy URL (use service name 'db' as hostname)
DATABASE_URL=postgresql+asyncpg://portfolio:portfolio_password@db:5432/portfolio_db
# Optional separate URL for Alembic (can be sync driver); if empty falls back to DATABASE_URL
# ALEMBIC_DATABASE_URL=postgresql+psycopg2://portfolio:portfolio_password@db:5432/portfolio_db

# CORS origins (comma separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Max upload size in bytes (default 5MB)
MAX_UPLOAD_SIZE= 5242880  # 5 * 1024 * 1024

# Directory inside container for uploads
UPLOAD_DIR=/tmp/portfolio_uploads

# ---------- Frontend -------------
# Host port that will map to nginx:80 inside the frontend container
FRONTEND_PORT=3000

# Frontend (Vite) client bundle base URL to reach backend from browser (use host-mapped port, not service DNS)
VITE_API_BASE_URL=http://localhost:${BACKEND_PORT}

# File watching in Docker (set true on Windows/macOS; can disable on Linux for performance)
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true

# ---------- Misc -----------------
# (Add any future feature flags / secrets below)

###############################################
# After editing run: docker compose up --build
###############################################